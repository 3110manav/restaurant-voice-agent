GROQ_API_KEY=
GOOGLE_API_KEY=
SARVAM_API_KEY=

# Optional: enables the ERP persistence layer (app/erp.py) that writes
# finalized orders and service/front-desk requests to Supabase. Leave blank
# to run without it — everything else works the same, just without that
# durability/staff-visibility layer. See supabase/schema.sql.
#
# SUPABASE_SERVICE_KEY must be the SECRET key (starts with sb_secret_ —
# Settings > API Keys > "Publishable and secret API keys" tab), not the
# publishable key (sb_publishable_...). This server writes directly and
# needs BYPASSRLS; the publishable key is the client-safe one and can't
# write past Row Level Security.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional: enables realtime, interruptible voice (app/voice/livekit_worker.py)
# as an alternative to the push-to-talk voice in the web app. Needs a free
# LiveKit Cloud project (Settings > Keys). Only read by the worker process,
# not by `uvicorn app.main:app` — see README's "Realtime voice (LiveKit)".
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Dish photos (python -m app.menu_images). Free key from https://www.pexels.com/api/ , only needed when running that script.
PEXELS_API_KEY=
