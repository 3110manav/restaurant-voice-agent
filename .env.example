GROQ_API_KEY=
GOOGLE_API_KEY=
SARVAM_API_KEY=

# Supabase holds the restaurants, menus, orders and table requests, so restaurant mode needs it
# (run supabase/migrations/001_multi_restaurant.sql once). Set on the API and the voice worker.
# Without it only the kirana agent and the standalone waiter work, and orders are not saved.
#
# SUPABASE_SERVICE_KEY must be the SECRET key (starts with sb_secret_ —
# Settings > API Keys > "Publishable and secret API keys" tab), not the
# publishable key (sb_publishable_...). This server writes directly and
# needs BYPASSRLS; the publishable key is the client-safe one and can't
# write past Row Level Security.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional: enables realtime, interruptible voice calls (app/voice/livekit_worker.py) as an
# alternative to the push-to-talk voice in the web app. Needs a free LiveKit Cloud project
# (Settings > Keys). Set the same three values on BOTH the API (it creates the call token)
# and the worker process. See README's "Realtime voice (LiveKit)".
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional, for local testing only: a different name keeps your local worker from competing with the one
# hosted on LiveKit Cloud (see README, "Hosting the worker on LiveKit Cloud"). Leave unset in production.
# LIVEKIT_AGENT_NAME=sarthi-voice-dev

# Dish photos (python -m app.menu_images). Free key from https://www.pexels.com/api/ , only needed when running that script.
PEXELS_API_KEY=

# --- WhatsApp (Meta Cloud API): order alerts to the shop, and chatting with customers. See README, "WhatsApp".
# The access token lives on BOTH the API (Render) and the voice worker, since a voice order alerts the shop.
# WHATSAPP_ACCESS_TOKEN=            # a system-user token from Meta (the temporary test token lasts 24h)
# The next three are for the webhook, so the API (Render) only:
# WHATSAPP_APP_SECRET=              # Meta app > Settings > Basic > App secret (verifies each webhook is really Meta's)
# WHATSAPP_VERIFY_TOKEN=            # any string you choose; paste the same one into Meta when registering the webhook
# WHATSAPP_ALLOW_UNSIGNED=1         # local testing only: accept webhooks with no signature. Never in production.
# WHATSAPP_MAX_ALERTS_PER_HOUR=60   # per store, so fake web orders can't spam the owner
