# Secrets for the worker hosted on LiveKit Cloud. Copy to secrets.env (git-ignored) and fill in.
# Do NOT add LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET: LiveKit Cloud provides them itself.
GROQ_API_KEY=
GOOGLE_API_KEY=
SARVAM_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Your hosted API (the Render address, no trailing slash). The worker syncs each guest's cart there;
# if this is missing, items ordered by voice won't appear in the cart on the page.
SARTHI_API_BASE_URL=

# WhatsApp: a voice order alerts the shop, so the worker needs the same token as the API (see README, "WhatsApp").
WHATSAPP_ACCESS_TOKEN=
