# URL of the Sarthi Python backend (FastAPI), used server-side by every /api/* proxy route.
# Local dev default shown. On Vercel, set this to your Render URL (e.g. https://xxx.onrender.com,
# no trailing slash) under Project Settings -> Environment Variables.
BACKEND_URL=http://localhost:8000

# Owner portal login (Supabase Auth). Both values are public by design — use the
# project URL and the PUBLISHABLE key (sb_publishable_...), never the secret key.
# Settings -> API Keys in the Supabase dashboard. Also set these on Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public address of this site (e.g. https://xxx.vercel.app). The landing page and /demo QR codes point
# here; if unset they use whatever address the page was opened on.
NEXT_PUBLIC_SITE_URL=
